{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted verification configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "kind": {
            "enum": [
              "project",
              "protected",
              "independent"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "const": "."
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "argv",
          "cwd",
          "required"
        ]
      },
      "minItems": 1
    }
  }
}

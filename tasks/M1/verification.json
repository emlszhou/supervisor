{
  "schema_version": 1,
  "checks": [
    {
      "id": "m1-unit",
      "kind": "project",
      "argv": [
        "python",
        "-m",
        "pytest",
        "tests/unit",
        "--junitxml=.supervisor/evidence/M1-unit.xml"
      ],
      "cwd": ".",
      "required": true
    },
    {
      "id": "m1-independent",
      "kind": "independent",
      "argv": [
        "python",
        "-B",
        "-m",
        "pytest",
        "${CONTRACT}/tests/protected/test_m1_acceptance.py",
        "--junitxml=.supervisor/evidence/M1-independent.xml"
      ],
      "cwd": ".",
      "required": true
    },
    {
      "id": "full-project",
      "kind": "project",
      "argv": [
        "python",
        "-m",
        "pytest"
      ],
      "cwd": ".",
      "required": true
    },
    {
      "id": "specs",
      "kind": "protected",
      "argv": [
        "python",
        "scripts/check_specs.py"
      ],
      "cwd": ".",
      "required": true
    },
    {
      "id": "lint",
      "kind": "project",
      "argv": [
        "ruff",
        "check",
        "src",
        "tests",
        "scripts"
      ],
      "cwd": ".",
      "required": true
    },
    {
      "id": "format",
      "kind": "project",
      "argv": [
        "ruff",
        "format",
        "--check",
        "src",
        "tests",
        "scripts"
      ],
      "cwd": ".",
      "required": true
    }
  ]
}

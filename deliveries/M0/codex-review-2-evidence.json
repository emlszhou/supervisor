  "probe_source": "import json,sys,subprocess,pathlib,time\nfrom dataclasses import replace\nfrom supervisor.workers.process import ProcessResult,ProcessRequest,ProcessRunner\nfrom supervisor.agents.base import parse_agent_result\nr=pathlib.Path('/tmp/m0-review-2'); expected=dict(task_id='M0-process-adapter',run_id='review-run',attempt_id='review-attempt',role='implementer',provider='mock')\nfull={**expected,'schema_version':1,'status':'completed','exit_code':0,'session_id':'session','truncated':False,'model':'test-model','summary':'retain summary','error':None,'usage':None,'artifacts':[{'path':'result.txt','sha256':'a'*64}]}\np=ProcessResult('completed',0,json.dumps(full).encode(),b'',.01,False,None,None)\nprobes=[]\nprior=json.loads(subprocess.check_output(['git','-C','/workspace/supervisor','show','origin/codex/m0-review-1:deliveries/M0/codex-review-1-evidence.json']))\nsource=prior['probe_source'].replace('/tmp/m0-fresh-review','/tmp/m0-review-2')\np0=subprocess.run([sys.executable,'-c',source],capture_output=True,timeout=3);probes.extend(json.loads(p0.stdout))\nfor label,pr in [('valid-fields-preserved',p),('process-timed-out-exit0',replace(p,status='timed_out')),('null-artifacts',replace(p,stdout=json.dumps({**full,'artifacts':None}).encode())),('boolean-usage',replace(p,stdout=json.dumps({**full,'usage':{'input_tokens':True,'output_tokens':False}}).encode())),('bool-schema-version',replace(p,stdout=json.dumps({**full,'schema_version':True}).encode())),('newline-id',replace(p,stdout=json.dumps({**full,'task_id':'M0-process-adapter\\n'}).encode()))]:\n probes.append({'probe':label,'result':parse_agent_result(pr,expected=expected).to_dict()})\nfor label,child,budget in [('one-byte-then-sleep','import os,time;os.write(1,b\"x\");time.sleep(.6)',4096),('both-streams-short-sleep','import os,time;os.write(1,b\"x\");os.write(2,b\"y\");time.sleep(.6)',4096),('exit-over-budget','import os;os.write(1,b\"x\"*4097)',4096),('exact-budget','import os;os.write(1,b\"x\"*64)',64)]:\n t=time.monotonic();q=ProcessRunner().run(ProcessRequest((sys.executable,'-c',child),r,r,{},timeout_seconds=.1,max_output_bytes=budget));probes.append({'probe':label,'status':q.status,'elapsed':time.monotonic()-t,'duration':q.duration_seconds,'captured':len(q.stdout)+len(q.stderr),'truncated':q.truncated,'cleanup':q.tree_cleanup_confirmed})\n# deterministic group-signal failure injection while child descendant sleeps\nimport unittest.mock as mock,os,signal\npidfile=pathlib.Path('/tmp/m0-review2-descendant.pid')\nchild='import subprocess,sys,time,pathlib;p=subprocess.Popen([sys.executable,\"-c\",\"import time;time.sleep(4)\"]);pathlib.Path(\"/tmp/m0-review2-descendant.pid\").write_text(str(p.pid));time.sleep(4)'\nwith mock.patch('supervisor.workers.process.os.killpg',side_effect=PermissionError('injected failure')):\n q=ProcessRunner().run(ProcessRequest((sys.executable,'-c',child),r,r,{},timeout_seconds=.1))\npid=int(pidfile.read_text());alive=True\ntry:os.kill(pid,0)\nexcept ProcessLookupError:alive=False\nprobes.append({'probe':'group-signal-failure','status':q.status,'cleanup':q.tree_cleanup_confirmed,'descendant_alive':alive})\ntry:os.kill(pid,signal.SIGKILL)\nexcept ProcessLookupError:pass\npathlib.Path('/tmp/m0-review2-probes.json').write_text(json.dumps(probes,indent=2));print(json.dumps(probes,indent=2))\n",
  "extra_probe_source": "import pathlib,sys,json,subprocess,os,signal\nfrom unittest.mock import patch\nfrom supervisor.workers.process import ProcessRunner,ProcessRequest\nr=pathlib.Path('/tmp/m0-review-2');req=ProcessRequest((sys.executable,'-c','import time;time.sleep(3)'),r,r,{},timeout_seconds=.1,require_tree_cleanup=False)\nwith patch('supervisor.workers.process.select.select',side_effect=OSError('simulated Windows pipes unsupported')):\n q=ProcessRunner().run(req)\nresults=[{'probe':'unsupported-select-pipe-simulation','status':q.status,'duration':q.duration_seconds,'runtime_windows_tested':False}]\nclass Broken(ProcessRunner):\n def _drive_process(self,p,*a):self.p=p;raise RuntimeError('injected drive failure')\nb=Broken();q=b.run(req);alive=b.p.poll() is None;results.append({'probe':'exception-path-reap','status':q.status,'leader_alive':alive});b.p.kill();b.p.wait()\nprint(json.dumps(results));pathlib.Path('/tmp/m0-review2-extra.json').write_text(json.dumps(results))\n",
